{
  "name": "glyphs-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Windows font editor inspired by the Glyphs 4 Handbook — core MVP",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test test/model.test.ts test/desktop.test.ts",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.shaikmoosa.glyphsforwindows",
    "productName": "Glyphs for Windows",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
